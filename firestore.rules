rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: Readable by any employee, writable by authorized store operators
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: Readable by all employees for tracking, creatable by employees, updatable by admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Store settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
